{
  "name": "ar2-crosshair",
  "productName": "AR2 Crosshair",
  "version": "1.8.1",
  "description": "Crosshair personnalisable affiché par-dessus tes jeux (Roblox, Apocalypse Rising 2...). Overlay transparent, aucune injection.",
  "main": "src/main.js",
  "author": "Surax000",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ar2.crosshair",
    "productName": "AR2 Crosshair",
    "copyright": "Surax000",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "AR2-Crosshair-Windows.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AR2 Crosshair",
      "artifactName": "AR2-Crosshair-Setup.${ext}",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "portable": {
      "artifactName": "AR2-Crosshair-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Surax000",
        "repo": "Ar2-wiki-et-map-interactive",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "AR2-Crosshair-Linux.${ext}",
      "category": "Utility"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8",
    "uiohook-napi": "^1.5.5"
  }
}
